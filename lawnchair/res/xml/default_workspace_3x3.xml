<favorites xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher3">

    <!-- Hotseat (We use the screen as the position of the item in the hotseat) -->
    <!-- Messaging, [All Apps], Dialer -->

    <resolve
        launcher:container="-101"
        launcher:screen="0"
        launcher:x="0"
        launcher:y="0" >
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_MESSAGING;end" />
        <favorite launcher:uri="sms:" />
        <favorite launcher:uri="smsto:" />
        <favorite launcher:uri="mms:" />
        <favorite launcher:uri="mmsto:" />
    </resolve>

    <!-- All Apps -->

    <resolve
        launcher:container="-101"
        launcher:screen="2"
        launcher:x="2"
        launcher:y="0" >
        <favorite
            launcher:className="com.android.contacts.activities.TwelveKeyDialer"
            launcher:packageName="com.android.contacts" />
        <favorite launcher:uri="#Intent;action=android.intent.action.DIAL;end" />
        <favorite launcher:uri="tel:123" />
        <favorite launcher:uri="#Intent;action=android.intent.action.CALL_BUTTON;end" />
    </resolve>

    <!-- Bottom row -->

    <!-- ANSUT Services folder (Ivorian mobile money & services).
         Each child tries the package's launcher activity via intent first,
         then falls back to a well-known component name. Items whose app is
         not installed are silently dropped. -->
    <folder
        launcher:title="@string/ansut_services_folder_title"
        launcher:screen="0"
        launcher:x="0"
        launcher:y="0">
        <favorite
            launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.LAUNCHER;package=com.wave.personal;end" />
        <favorite
            launcher:packageName="com.wave.personal"
            launcher:className="com.wave.personal.MainActivity"/>
        <favorite
            launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.LAUNCHER;package=com.orange.orangemoneyafrique;end" />
        <favorite
            launcher:packageName="com.orange.orangemoneyafrique"
            launcher:className="com.orange.orangemoneyafrique.MainActivity"/>
        <favorite
            launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.LAUNCHER;package=ci.moovmoney.mmpayapi;end" />
        <favorite
            launcher:packageName="ci.moovmoney.mmpayapi"
            launcher:className="ci.moovmoney.mmpayapi.MainActivity"/>
    </folder>

    <!-- WhatsApp -->
    <resolve
        launcher:screen="0"
        launcher:x="1"
        launcher:y="0">
        <favorite
            launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.LAUNCHER;package=com.whatsapp;end" />
        <favorite
            launcher:packageName="com.whatsapp"
            launcher:className="com.whatsapp.Main"/>
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="0"
        launcher:y="-1" >
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_EMAIL;end" />
        <favorite launcher:uri="mailto:" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="1"
        launcher:y="-1" >
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_GALLERY;end" />
        <favorite launcher:uri="#Intent;type=images/*;end" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="2"
        launcher:y="-1" >
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_MARKET;end" />
        <favorite launcher:uri="market://details?id=com.android.launcher" />
    </resolve>

    <!-- ANSUT: widget « Solde & Forfaits » — solde Orange/MTN/Moov en un appui.
         packageName="@launcher" est résolu vers l'applicationId du flavor courant
         (voir AutoInstallsLayout.PendingWidgetParser). -->
    <appwidget
        launcher:packageName="@launcher"
        launcher:className="app.lawnchair.ansut.AnsutSoldeWidgetProvider"
        launcher:screen="0"
        launcher:spanX="3"
        launcher:spanY="1"
        launcher:x="0"
        launcher:y="1"/>

</favorites>
