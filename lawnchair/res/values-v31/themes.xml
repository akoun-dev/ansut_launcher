<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ANSUT : splash système Android 12+ — fond bleu ANSUT, monogramme orange
         (adaptive icon masqué en cercle par le système, le disque se fond dans
         le fond). LawnchairLauncher restaure AppTheme dans onCreate. -->
    <style name="Theme.AnsutSplash" parent="@style/AppTheme">
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/ansut_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ansut_splash_icon</item>
    </style>
</resources>
